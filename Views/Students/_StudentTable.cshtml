@model Lab9.ViewModels.StudentIndexViewModel
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var descending = Model.Sort == "name_desc";
    var query = new Dictionary<string, string?>
    {
        ["search"] = Model.Search,
        ["address"] = Model.Address,
        ["campusID"] = Model.CampusID?.ToString(),
        ["sort"] = Model.Sort
    };
    var sortQuery = new Dictionary<string, string?>(query)
    {
        ["sort"] = descending ? "name_asc" : "name_desc",
        ["page"] = "1"
    };
}
<table>
<thead>
    <tr>
        <th>ID</th>
        <th aria-sort="@(descending ? "descending" : "ascending")">
            <a asp-action="@action" asp-all-route-data="@sortQuery">Name @(descending ? "↓" : "↑")</a>
        </th>
        <th>Address</th><th>Campus</th><th>Actions</th>
    </tr>
</thead>
<tbody>
@foreach (var item in Model.Students)
{
    <tr><td>@item.ID</td><td>@item.Name</td><td>@item.Address</td><td>@item.Campus.Name</td><td class="actions"><a asp-action="Details" asp-route-id="@item.ID">Details</a><a asp-action="Edit" asp-route-id="@item.ID">Edit</a><a asp-action="Delete" asp-route-id="@item.ID">Delete</a></td></tr>
}
@if (Model.TotalStudents == 0)
{
    <tr><td colspan="5">No students match these filters.</td></tr>
}
</tbody>
</table>
@if (Model.TotalPages > 1)
{
    <nav class="pagination" aria-label="Student pages">
        @if (Model.Page > 1)
        {
            <a asp-action="@action" asp-all-route-data="@query" asp-route-page="@(Model.Page - 1)">Previous</a>
        }
        <span>Page @Model.Page of @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a asp-action="@action" asp-all-route-data="@query" asp-route-page="@(Model.Page + 1)">Next</a>
        }
    </nav>
}
